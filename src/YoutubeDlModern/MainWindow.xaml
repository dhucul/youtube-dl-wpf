<Window x:Class="YoutubeDlModern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YoutubeDL Modern"
        Width="1140" Height="780" MinWidth="940" MinHeight="620"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Navigation rail ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource NavRailBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="6,14,6,0">
                    <!-- Brand -->
                    <Border Width="44" Height="44"
                            CornerRadius="12"
                            Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE768;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{StaticResource AccentTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="YoutubeDL"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,2" />
                    <TextBlock Text="Modern"
                               Style="{StaticResource SecondaryText}"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18" />

                    <!-- Nav buttons -->
                    <Button Content="Downloads" Tag="&#xE896;"
                            Command="{Binding NavigateCommand}" CommandParameter="Queue">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav}" Value="Queue">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="History" Tag="&#xE81C;" Margin="0,6,0,0"
                            Command="{Binding NavigateCommand}" CommandParameter="History">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav}" Value="History">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Settings" Tag="&#xE713;" Margin="0,6,0,0"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav}" Value="Settings">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="About" Tag="&#xE946;" Margin="0,6,0,0"
                            Command="{Binding NavigateCommand}" CommandParameter="About">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav}" Value="About">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Engine status -->
                <StackPanel Grid.Row="1" Margin="6,0,6,12">
                    <TextBlock Text="{Binding EngineStatusText}"
                               Style="{StaticResource SecondaryText}"
                               FontSize="9.5"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               ToolTip="Download engine status (yt-dlp)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}" Margin="26,20,26,20" />

            <!-- Toast notification -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,26,20"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,10"
                    MaxWidth="480"
                    Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="100">
                <TextBlock Text="{Binding NotificationText}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</Window>
