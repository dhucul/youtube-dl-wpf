<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>YoutubeDlModern</AssemblyName>
    <RootNamespace>YoutubeDlModern</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyTitle>YoutubeDL Modern</AssemblyTitle>
    <Description>A modern WPF interface for the classic youtube-dl feature set, powered by the yt-dlp engine.</Description>
    <Product>YoutubeDL Modern</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" />
  </ItemGroup>

</Project>
