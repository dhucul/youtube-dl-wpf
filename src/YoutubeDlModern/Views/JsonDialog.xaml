<Window x:Class="YoutubeDlModern.Views.JsonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="560"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleBlock" Grid.Row="0" Style="{StaticResource SectionText}" Margin="0,0,0,10" />

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
            <TextBox x:Name="ContentBox"
                     IsReadOnly="True"
                     FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="Transparent" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource MiniButton}" Content="Copy all" Click="Copy_Click" Margin="0,0,8,0" />
            <Button Style="{StaticResource AccentButton}" Content="Close" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
