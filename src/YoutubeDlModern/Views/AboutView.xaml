<UserControl x:Class="YoutubeDlModern.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YoutubeDlModern.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:NullVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860">
            <TextBlock Text="About" Style="{StaticResource HeadingText}" Margin="0,0,0,14" />

            <!-- App card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="YoutubeDL Modern" FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="19" FontWeight="SemiBold" />
                            <Border Style="{StaticResource StatusChip}" Background="{StaticResource SurfaceBrush}" Margin="10,0,0,0">
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding AppVersion, StringFormat='v{0}'}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="A modern Windows remake of the classic youtube-dl — every original option, a real GUI, and a living engine (yt-dlp) underneath. Built with WPF on .NET 10." />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource MiniButton}" Content="youtube-dl (original project)"
                                    Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/ytdl-org/youtube-dl" />
                            <Button Style="{StaticResource MiniButton}" Margin="8,0,0,0" Content="yt-dlp engine"
                                    Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/yt-dlp/yt-dlp" />
                            <Button Style="{StaticResource MiniButton}" Margin="8,0,0,0" Content="ffmpeg"
                                    Command="{Binding OpenLinkCommand}" CommandParameter="https://ffmpeg.org" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Engine card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="Download engine (yt-dlp)" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Status:" />
                        <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Text="{Binding EngineVersionText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Location:" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="8,0,0,0" FontSize="11"
                                   Text="{Binding EnginePath}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Command="{Binding ReinstallEngineCommand}"
                                IsEnabled="{Binding IsEngineBusy, Converter={StaticResource InverseBool}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Setter Property="Content" Value="Reinstall engine" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineInstalled}" Value="False">
                                            <Setter Property="Content" Value="Install engine" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEngineBusy}" Value="True">
                                            <Setter Property="Content" Value="Working…" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource MiniButton}" Margin="10,0,0,0" Content="Open engine folder"
                                Command="{Binding OpenEngineFolderCommand}" />
                    </StackPanel>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                            Visibility="{Binding EngineLog, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding EngineLog}" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ffmpeg card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="ffmpeg (post-processing)" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Required for merging best video + audio, extracting audio (-x), recoding and embedding. Auto-detected from PATH, a custom folder, or installed by the app." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Status:" />
                        <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12"
                                   Text="{Binding FfmpegStatusText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Download ffmpeg"
                                IsEnabled="{Binding IsFfmpegBusy, Converter={StaticResource InverseBool}}"
                                Visibility="{Binding IsFfmpegAvailable, Converter={StaticResource InverseBoolToVis}}"
                                Command="{Binding InstallFfmpegCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,30"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Please respect the terms of service of the sites you download from and only download content you have the right to save. This project is a GUI front-end and is not affiliated with youtube-dl, yt-dlp or ffmpeg." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
