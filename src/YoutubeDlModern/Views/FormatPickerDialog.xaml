<Window x:Class="YoutubeDlModern.Views.FormatPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="940" Height="650" MinWidth="720" MinHeight="460"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleBlock" Grid.Row="0" Style="{StaticResource SectionText}" />
        <TextBlock Grid.Row="1" Margin="0,5,0,12" Style="{StaticResource SecondaryText}"
                   Text="Select a row and choose Use selected format. Double-clicking a row also applies it." />

        <Grid Grid.Row="2" Margin="13,0,13,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="115" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="105" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource SecondaryText}" Text="ID" />
            <TextBlock Grid.Column="1" Style="{StaticResource SecondaryText}" Text="Media" />
            <TextBlock Grid.Column="2" Style="{StaticResource SecondaryText}" Text="Resolution" />
            <TextBlock Grid.Column="3" Style="{StaticResource SecondaryText}" Text="Type" />
            <TextBlock Grid.Column="4" Style="{StaticResource SecondaryText}" Text="Codecs / note" />
            <TextBlock Grid.Column="5" Style="{StaticResource SecondaryText}" Text="Size / rate" />
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
            <ListBox x:Name="FormatList"
                     AutomationProperties.Name="Available download formats"
                     SelectionMode="Single"
                     SelectionChanged="FormatList_SelectionChanged"
                     MouseDoubleClick="FormatList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,3" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="RowBorder" Padding="9,7" CornerRadius="5"
                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource CardBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="115" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="105" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FormatId}" FontFamily="{StaticResource MonoFontFamily}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FormatId}" />
                            <TextBlock Grid.Column="1" Text="{Binding MediaType}" />
                            <TextBlock Grid.Column="2" Text="{Binding Resolution}" />
                            <TextBlock Grid.Column="3" Text="{Binding Extension}" />
                            <TextBlock Grid.Column="4" Text="{Binding Details}" Margin="0,0,10,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                            <TextBlock Grid.Column="5" Text="{Binding SizeAndRate}"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox x:Name="AddAudioCheckBox" Grid.Row="0"
                      Content="Add the best available audio to this video-only format"
                      Checked="AddAudioCheckBox_Changed" Unchecked="AddAudioCheckBox_Changed"
                      Visibility="Collapsed" />
            <TextBlock x:Name="SelectorPreview" Grid.Row="1" Margin="0,7,0,0"
                       FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Select a format to preview its download selector." />
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CopyButton" Style="{StaticResource MiniButton}" Content="Copy selector"
                    IsEnabled="False" Click="Copy_Click" Margin="0,0,8,0" />
            <Button Style="{StaticResource MiniButton}" Content="Cancel" IsCancel="True"
                    Click="Cancel_Click" Margin="0,0,8,0" />
            <Button x:Name="UseButton" Style="{StaticResource AccentButton}" Content="Use selected format"
                    AutomationProperties.Name="Use selected format" IsDefault="True"
                    IsEnabled="False" Click="Use_Click" />
        </StackPanel>
    </Grid>
</Window>
