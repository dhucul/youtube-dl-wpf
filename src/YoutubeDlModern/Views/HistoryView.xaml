<UserControl x:Class="YoutubeDlModern.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YoutubeDlModern.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="History" Style="{StaticResource HeadingText}" />
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,3,0,0"
                           Text="Everything downloaded with YoutubeDL Modern (persisted in %APPDATA%\YoutubeDlModern)." />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource MiniButton}" Content="Clear history"
                    Command="{Binding ClearCommand}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="40,34"
                Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextAlignment="Center"
                           Text="No downloads recorded yet." />
            </StackPanel>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding Entries}"
                 Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding Url}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="11"
                                               Text="{Binding CompletedAt, StringFormat='{}{0:g}'}" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="11" Margin="10,0,0,0"
                                               Text="{Binding Site}" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="11" Margin="10,0,0,0"
                                               Text="{Binding FilePath}"
                                               Visibility="{Binding FilePath, Converter={StaticResource NullToVis}, ConverterParameter=invert}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="520"
                                               ToolTip="{Binding FilePath}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource MiniButton}" Content="▶ Play"
                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource MiniButton}" Margin="8,0,0,0" Content="📁 Folder"
                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource MiniButton}" Margin="8,0,0,0" Content="Remove"
                                        Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
